{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axom-flood.local/schemas/smart-axom-gauge-circles.schema.json",
  "title": "SMART AXOM gauge roster and revenue-circle crosswalk",
  "description": "Reference snapshot of ASDMA's SMART AXOM water-level roster. Not a live source: every station is also in CWC FFS, which is fresher. Its purpose is the revenue-circle name FFS does not publish.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "source_url",
    "source_endpoint",
    "fetched_at",
    "usage",
    "station_count",
    "stations"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "source_endpoint": {
      "type": "string",
      "format": "uri"
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time"
    },
    "usage": {
      "type": "string",
      "minLength": 1
    },
    "station_count": {
      "type": "integer",
      "minimum": 1
    },
    "stations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cwc_station_code",
          "site_name",
          "revenue_circle_source_name",
          "district_source_name",
          "river_source_name",
          "basin_source_name",
          "station_type",
          "danger_level_m",
          "warning_level_m",
          "highest_flood_level_m",
          "observed_level_m",
          "observed_at"
        ],
        "properties": {
          "cwc_station_code": {
            "type": "string",
            "minLength": 1
          },
          "site_name": {
            "type": "string",
            "minLength": 1
          },
          "revenue_circle_source_name": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "district_source_name": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "river_source_name": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "basin_source_name": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "station_type": {
            "type": ["string", "null"],
            "enum": ["Level", "Inflow", "Base", null]
          },
          "danger_level_m": {
            "type": ["number", "null"]
          },
          "warning_level_m": {
            "type": ["number", "null"]
          },
          "highest_flood_level_m": {
            "type": ["number", "null"]
          },
          "observed_level_m": {
            "type": ["number", "null"]
          },
          "observed_at": {
            "type": ["string", "null"],
            "minLength": 1
          }
        }
      }
    }
  }
}
