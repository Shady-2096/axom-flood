{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/axom-flood/schemas/imerg-cell-accumulation-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "grid_cell_id",
    "run",
    "interval_start",
    "interval_end",
    "total_precipitation_mm",
    "interval_count",
    "source_revision_sha256s"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "grid_cell_id": {"type": "string", "minLength": 1},
    "run": {"enum": ["early", "late"]},
    "interval_start": {"type": "string", "format": "date-time"},
    "interval_end": {"type": "string", "format": "date-time"},
    "total_precipitation_mm": {"type": "number", "minimum": 0},
    "interval_count": {"type": "integer", "minimum": 1},
    "source_revision_sha256s": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  }
}
