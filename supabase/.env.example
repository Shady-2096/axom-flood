# Copy to supabase/.env.local for local function serving. Never commit real values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# New hosted projects may use SB_SECRET_KEY instead.
SB_SECRET_KEY=

# Generate with at least 32 random characters. Rotation requires a planned
# identity-period transition; do not reuse a platform token here.
REPORTING_HMAC_SECRET=replace-with-at-least-32-random-characters
REPORTING_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set the Graph API version approved for the Meta app; no guessed default.
WHATSAPP_GRAPH_VERSION=
